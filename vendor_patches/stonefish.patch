+    const bool cacheable = !pathError && !timeError;
+    const MeshCacheKey key{cacheable ? absolute.string() : filename, scale, smooth, mtime};
+
+    if(cacheable)
+    {
+        std::lock_guard<std::mutex> lock(gMeshCacheMutex);
+        const auto found = gMeshCache.find(key);
+        if(found != gMeshCache.end())
