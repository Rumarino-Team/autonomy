+namespace
+{
+
+struct MeshCacheKey
+{
+    std::string path;
+    GLfloat scale;
+    bool smooth;
+    std::filesystem::file_time_type mtime;
+
+    bool operator==(const MeshCacheKey& other) const
+    {
+        return path == other.path && scale == other.scale && smooth == other.smooth && mtime == other.mtime;
+    }
+};
+
+struct MeshCacheKeyHash
+{
+    std::size_t operator()(const MeshCacheKey& key) const
+    {
+        std::size_t hash = std::hash<std::string>{}(key.path);
+        hash ^= std::hash<float>{}(key.scale) + 0x9e3779b9 + (hash << 6) + (hash >> 2);
+        hash ^= std::hash<bool>{}(key.smooth) + 0x9e3779b9 + (hash << 6) + (hash >> 2);
+        const auto ticks = key.mtime.time_since_epoch().count();
+        hash ^= static_cast<std::size_t>(ticks) + 0x9e3779b9 + (hash << 6) + (hash >> 2);
+        return hash;
+    }
+};
+
+std::mutex gMeshCacheMutex;
+std::unordered_map<MeshCacheKey, std::unique_ptr<Mesh>, MeshCacheKeyHash> gMeshCache;
+
+Mesh* CloneMesh(const Mesh* source)
+{
+    if(source->isTexturable())
+    {
+        const auto* textured = static_cast<const TexturableMesh*>(source);
+        auto* copy = new TexturableMesh();
+        copy->vertices = textured->vertices;
+        copy->faces = textured->faces;
+        return copy;
+    }
+
+    const auto* plain = static_cast<const PlainMesh*>(source);
+    auto* copy = new PlainMesh();
+    copy->vertices = plain->vertices;
+    copy->faces = plain->faces;
+    return copy;
+}
+
+void DropStaleMeshCacheEntries(const MeshCacheKey& key)
+{
+    for(auto it = gMeshCache.begin(); it != gMeshCache.end();)
+    {
+        const bool sameMesh = it->first.path == key.path && it->first.scale == key.scale && it->first.smooth == key.smooth;
+        if(sameMesh && !(it->first.mtime == key.mtime))
+            it = gMeshCache.erase(it);
+        else
+            ++it;
+    }
+}
+
+}
