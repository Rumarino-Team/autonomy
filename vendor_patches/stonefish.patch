+void DeleteStaticShape(btCollisionShape* shape)
+{
+    if(auto* compound = dynamic_cast<btCompoundShape*>(shape))
+        for(int i = 0; i < compound->getNumChildShapes(); ++i)
+            DeleteStaticShape(compound->getChildShape(i));
+    if(auto* mesh = dynamic_cast<btBvhTriangleMeshShape*>(shape))
+    {
+        auto* array = dynamic_cast<btTriangleIndexVertexArray*>(mesh->getMeshInterface());
+        if(array != nullptr)
+        {
+            for(int i = 0; i < array->getIndexedMeshArray().size(); ++i)
+            {
+                const auto& part = array->getIndexedMeshArray()[i];
+                delete[] reinterpret_cast<const Scalar*>(part.m_vertexBase);
+                delete[] reinterpret_cast<const int*>(part.m_triangleIndexBase);
+            }
+            delete array;
+        }
+    }
+    delete shape;
+}
+}
+
+void StaticEntity::ReleasePhysics()
+{
+    if(rigidBody == nullptr)
+        return;
+    DeleteStaticShape(rigidBody->getCollisionShape());
+    delete rigidBody->getMotionState();
+    delete rigidBody;
+    rigidBody = nullptr;
+}
+
+void StaticEntity::ReleaseGraphics()
+{
+    if(phyObjectId >= 0 && SimulationApp::getApp()->hasGraphics())
+        static_cast<GraphicalSimulationApp*>(SimulationApp::getApp())->getGLPipeline()->getContent()->ReleaseObject(phyObjectId);
+    phyObjectId = -1;
+}
