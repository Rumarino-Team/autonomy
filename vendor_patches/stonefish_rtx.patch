+    float dhdx = (poolRipple(x + e, y, time, waterWave) - poolRipple(x - e, y, time, waterWave)) / (2.f * e);
+    float dhdy = (poolRipple(x, y + e, time, waterWave) - poolRipple(x, y - e, time, waterWave)) / (2.f * e);
+    return normalize(make_float3(dhdx, dhdy, 1.f));
+}
