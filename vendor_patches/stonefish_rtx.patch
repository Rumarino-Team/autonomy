+// Upward displacement of a short pool chop, in metres. waterWave is the Stonefish sea state.
+static __forceinline__ __device__ float poolRipple(float x, float y, float time, float waterWave)
+{
+    float a = fminf(waterWave * 0.1f, 0.04f);
+    float h = 0.f;
+    h += a * sinf(6.2f * x + 1.15f * time);
+    h += a * 0.65f * sinf(5.4f * y - 0.85f * time);
+    h += a * 0.40f * sinf(4.1f * x + 3.3f * y + 1.55f * time);
+    h += a * 0.22f * sinf(11.f * x - 8.f * y - 2.1f * time);
+    return h;
+}
+
+// Downward normal (NED +Z, into the water) of the surface z = waterZ - h.
+static __forceinline__ __device__ float3 poolRippleDownNormal(float x, float y, float time, float waterWave)
