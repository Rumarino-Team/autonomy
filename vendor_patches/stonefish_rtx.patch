+    rSettings.ssr = reflections ? RenderQuality::HIGH : RenderQuality::DISABLED;
+    for(size_t i = 0; i < content->getViewsCount(); ++i)
+        if(auto* camera = dynamic_cast<OpenGLCamera*>(content->getView(i)))
+            camera->setAntiAliasing(aa);
+}
