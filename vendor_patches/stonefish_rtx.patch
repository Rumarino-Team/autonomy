+bool OpenGLPipeline::ConfigureRTX(bool enabled, bool dlss, unsigned int spp, unsigned int bounces,
+                                  const std::string& quality, bool debugAlbedo)
+{
+#ifdef STONEFISH_HAS_RTX
+    if(enabled && (rtx == nullptr || rSettings.rtxOffline))
+    {
+        delete rtx;
+        rtx = RTXRenderer::Create(dlss, false);
+    }
+    bool supported = !enabled || rtx != nullptr;
+    if(rtx != nullptr && enabled) supported = rtx->Configure(spp, bounces, dlss, quality, debugAlbedo) && supported;
+    rSettings.rtx = enabled && rtx != nullptr;
+    if(enabled) rSettings.rtxOffline = false;
+    rSettings.dlss = dlss;
+    if(!supported) cWarning("Requested RTX/DLSS settings unavailable; using the available render path");
+    return supported;
+#else
+    if(enabled) cWarning("RTX requested, but this build has no OptiX renderer; using OpenGL");
+    return !enabled;
+#endif
+}
