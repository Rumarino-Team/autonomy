+bool SimulationManager::RemoveStaticEntity(StaticEntity* ent)
+{
+    auto it = std::find(entities.begin(), entities.end(), ent);
+    if(it == entities.end())
+        return false;
+    if(SimulationApp::getApp()->hasGraphics())
+    {
+        auto* app = static_cast<GraphicalSimulationApp*>(SimulationApp::getApp());
+        if(app->getSelectedEntity().first == ent)
+            app->ClearEntitySelection();
+    }
+    for(auto c = contacts.begin(); c != contacts.end();)
+        if((*c)->getEntityA() == ent || (*c)->getEntityB() == ent)
+        {
+            delete *c;
+            c = contacts.erase(c);
+        }
+        else ++c;
+    collisions.erase(std::remove_if(collisions.begin(), collisions.end(),
+        [ent](const Collision& c) { return c.A == ent || c.B == ent; }), collisions.end());
+    if(ent->getRigidBody() != nullptr)
+        dynamicsWorld->removeRigidBody(ent->getRigidBody());
+    entities.erase(it);
+    ent->ReleasePhysics();
+    return true;
+}
