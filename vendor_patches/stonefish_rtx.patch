+void SimulationManager::UpdateOcean(Scalar waves, Fluid fluid)
+{
+    const bool graphics = SimulationApp::getApp()->hasGraphics();
+    waves = graphics ? waves : Scalar(0);
+    bool allocate = ocean == nullptr;
+    if(ocean == nullptr)
+        EnableOcean(waves, fluid);
+    else
+    {
+        ocean->setLiquid(fluid);
+        allocate = ocean->setWaves(waves, simHydroMutex);
+    }
+    if(graphics && allocate)
+        ocean->getOpenGLOcean()->AllocateParticles(static_cast<GraphicalSimulationApp*>(SimulationApp::getApp())->getGLPipeline()->getContent()->getView(0));
+}
